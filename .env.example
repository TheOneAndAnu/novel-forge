# Required — Anthropic API key for novel generation
ANTHROPIC_API_KEY=sk-ant-...

# Required for Vercel deployment — enables Vercel Blob storage
# Create a Blob store in your Vercel project dashboard (Storage tab)
# then paste the token here. Without this, the app falls back to
# local filesystem storage (fine for local dev, not for Vercel).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
